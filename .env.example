# ===============================
# Environment Variables Template
# ===============================

# IMPORTANT:
# Use KEY=value format (no spaces around '=')
# Do NOT add quotes unless needed (e.g. spaces in value)

# Create your own .env at project root

# 1. Copy this file:
#    cp .env.example .env
#
# 2. Set your own secret key:
#    GAME_SECRET_KEY=your-secret-key
#
# 3. Quick test:
#    flask shell
#    from app import app
#    print(app.config["SECRET_KEY"])
#
#    Should print the secret key you set
#    If printed None:
#    - Make sure .env exists and is correctly set
#    - Restart the terminal or flask shell
#    - Ensure dependencies are installed (pip install -r requirements.txt)

GAME_SECRET_KEY=your-own-secret-key